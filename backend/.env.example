DATABASE_URL=
# For Render, retain your existing hosted database and Qdrant connection values.
# REPOS_DIR is optional: unset uses /tmp/aci-repos on Render.
# Set it only to override storage, e.g. a directory under an attached disk's mount.
QDRANT_URL=
QDRANT_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=60
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=768
QDRANT_VECTOR_SIZE=768
EMBEDDING_BATCH_SIZE=16
OPENAI_EMBEDDING_MAX_RETRIES=6
OPENAI_EMBEDDING_RETRY_BASE_SECONDS=2
HYBRID_DENSE_CANDIDATES=30
HYBRID_LEXICAL_CANDIDATES=30
LEXICAL_SCAN_LIMIT=5000
GRAPH_EXPANSION_RESULTS=5
ARCHITECTURE_HIGH_COUPLING_THRESHOLD=8
CHANGE_IMPACT_MAX_DEPTH=4
CORS_ALLOWED_ORIGINS=https://ai-codebase-intelligence.vercel.app
GITHUB_WEBHOOK_SECRET=
